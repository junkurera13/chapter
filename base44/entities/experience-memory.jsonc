{
  "name": "ExperienceMemory",
  "type": "object",
  "properties": {
    "phone": { "type": "string", "description": "Caller phone (iMessage channel). Optional for web-only users." },
    "auth_user_id": { "type": "string", "description": "Base44 auth user id; always set on web, backfilled on iMessage when the SidequestUser is linked." },
    "owner_user_id": { "type": "string", "description": "SidequestUser that owns this private memory" },
    "client_request_id": { "type": "string", "description": "Caller-generated idempotency key" },
    "source": { "type": "string", "enum": ["onboarding", "reflection"] },
    "input_kind": { "type": "string", "enum": ["text", "image", "mixed"] },
    "raw_text": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "complete", "failed"] },
    "processing_stage": { "type": "string", "enum": ["preserving_sources", "extracting", "persisting_graph", "complete", "failed"] },
    "extractor_version": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "image_count": { "type": "number" },
    "source_count": { "type": "number" },
    "error": { "type": "string" },
    "created_at": { "type": "number" },
    "processing_started_at": { "type": "number" },
    "processed_at": { "type": "number" }
  },
  "required": ["source", "raw_text", "status", "created_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
