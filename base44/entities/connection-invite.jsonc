{
  "name": "ConnectionInvite",
  "type": "object",
  "properties": {
    "inviter_user_id": { "type": "string" },
    "inviter_node_id": { "type": "string" },
    "invited_name": { "type": "string" },
    "code": {
      "type": "string",
      "description": "Short single-use invite code as written, so the same link can be handed out again"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the code; also matches long tokens issued before short codes"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "accepted", "revoked", "expired"]
    },
    "expires_at": { "type": "number" },
    "accepted_by_user_id": { "type": "string" },
    "connection_id": { "type": "string" },
    "created_at": { "type": "number" },
    "accepted_at": { "type": "number" }
  },
  "required": ["inviter_user_id", "inviter_node_id", "invited_name", "status", "expires_at", "created_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
