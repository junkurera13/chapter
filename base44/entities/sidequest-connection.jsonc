{
  "name": "SidequestConnection",
  "type": "object",
  "properties": {
    "pair_key": {
      "type": "string",
      "description": "Stable sorted pair of SidequestUser IDs for idempotency"
    },
    "user_a_id": { "type": "string" },
    "user_b_id": { "type": "string" },
    "user_a_node_id": { "type": "string" },
    "user_b_node_id": { "type": "string" },
    "invite_id": {
      "type": "string",
      "description": "The accepted invite, when the two people found each other by name"
    },
    "introduction_id": {
      "type": "string",
      "description": "The accepted introduction, when Chapter put the two of them together instead"
    },
    "origin": {
      "type": "string",
      "enum": ["invite", "introduction"]
    },
    "status": { "type": "string", "enum": ["accepted", "blocked"] },
    "met_at": {
      "type": "number",
      "description": "First lived meeting recorded for an introduction-origin pair. Until this exists, weekly experience design treats the person as the new-person stretch."
    },
    "met_via_weekly_pack_id": {
      "type": "string",
      "description": "The weekly pack whose chosen social experience first became lived."
    },
    "created_at": { "type": "number" }
  },
  // `invite_id` was required while an invite was the only way to connect. It is
  // now one of two origins, so the requirement moved to `origin` instead.
  "required": ["pair_key", "user_a_id", "user_b_id", "status", "created_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
