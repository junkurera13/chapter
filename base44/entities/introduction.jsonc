{
  "name": "Introduction",
  "type": "object",
  "properties": {
    "pair_key": {
      "type": "string",
      "description": "Stable sorted pair of SidequestUser IDs, so a pair is only ever offered once"
    },
    "user_a_id": { "type": "string" },
    "user_b_id": { "type": "string" },
    "user_a_name": { "type": "string" },
    "user_b_name": { "type": "string" },
    "line": {
      "type": "string",
      "description": "The one sentence both people see, written only from the strict intersection of their two shareable graphs"
    },
    "anchors_json": {
      "type": "string",
      "description": "The shared labels the line is built from, as labels and categories only, resolved to node IDs per reader at read time"
    },
    "shared_weight": {
      "type": "number",
      "description": "Combined salience of everything the two worlds share, used to rank candidates"
    },
    "user_a_response": {
      "type": "string",
      "enum": ["pending", "yes", "no"],
      "description": "Legacy response marker retained for rows created by the superseded anonymous flow"
    },
    "user_b_response": {
      "type": "string",
      "enum": ["pending", "yes", "no"],
      "description": "Legacy response marker retained for rows created by the superseded anonymous flow"
    },
    "status": {
      "type": "string",
      "enum": ["offered", "message_pending", "connected", "declined", "expired"]
    },
    "opening_sender_user_id": { "type": "string" },
    "opening_message": { "type": "string" },
    "message_sent_at": { "type": "number" },
    "connection_id": {
      "type": "string",
      "description": "Set when the opening-message recipient accepts and a real connection is created"
    },
    "created_at": { "type": "number" },
    "expires_at": { "type": "number" },
    "user_a_responded_at": { "type": "number" },
    "user_b_responded_at": { "type": "number" },
    "connected_at": { "type": "number" }
  },
  "required": [
    "pair_key",
    "user_a_id",
    "user_b_id",
    "line",
    "status",
    "created_at",
    "expires_at"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
