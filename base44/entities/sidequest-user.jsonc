{
  "name": "SidequestUser",
  "type": "object",
  "properties": {
    "auth_user_id": {
      "type": "string",
      "description": "Base44 authenticated user ID for the private app account"
    },
    "email": {
      "type": "string",
      "description": "Verified email supplied by Base44 authentication"
    },
    "phone": { "type": "string", "description": "E.164 phone number" },
    "first_seen_at": { "type": "number" },
    "country": { "type": "string" },
    "name": { "type": "string" },
    "home_city": { "type": "string" },
    "current_city": { "type": "string" },
    "on_vacation": { "type": "boolean" },
    "introductions_opt_in": {
      "type": "boolean",
      "description": "Whether this account may be offered introductions to people it has not met. Absent means no."
    },
    "introductions_opt_in_at": { "type": "number" },
    "notes": { "type": "string" },
    "memory_updated_at": { "type": "number" },
    "eve_session_id": {
      "type": "string",
      "description": "Durable Eve conversation session id"
    },
    "eve_continuation_token": {
      "type": "string",
      "description": "Opaque Eve continuation token for the user's shared Chapter conversation"
    },
    "eve_stream_index": {
      "type": "number",
      "description": "Last consumed Eve event index"
    },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "signed_up_at": { "type": "number" },
    "assigned_phone": { "type": "string" },
    "onboarding_step": {
      "type": "string",
      "enum": [
        "needs_memory_invite",
        "awaiting_memory",
        "memory_ready"
      ]
    }
  },
  "required": ["first_seen_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
