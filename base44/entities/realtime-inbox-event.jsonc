{
  "name": "RealtimeInboxEvent",
  "type": "object",
  "properties": {
    "recipient_auth_user_id": {
      "type": "string",
      "description": "The only authenticated account allowed to receive this content-free refresh signal",
    },
    "kind": {
      "type": "string",
      "enum": ["human_message"],
    },
    "created_at": { "type": "number" },
  },
  "required": ["recipient_auth_user_id", "kind", "created_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.recipient_auth_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
      ],
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } },
  },
}
