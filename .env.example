# Web app
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# The public web app is closed by default. Set CHAPTER_APP_OPEN=true to reopen
# it without the shared gate. Use a separate random cookie secret in production.
CHAPTER_ACCESS_PASSWORD=utility
CHAPTER_ACCESS_COOKIE_SECRET=
CHAPTER_APP_OPEN=false

# Private Chapter agent. CHAPTER_AGENT_SECRET must also be set in Convex.
CHAPTER_AGENT_SECRET=
CHAPTER_TEST_IMESSAGE_HANDLE=

# Photon iMessage transport
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=

# OpenRouter composition model
OPENROUTER_API_KEY=
OPENROUTER_CONVERSATION_MODEL=openai/gpt-5.6-luna
OPENROUTER_MODEL_CONTEXT_WINDOW_TOKENS=1050000

# Parallel deep discovery and logistics verification
PARALLEL_API_KEY=
